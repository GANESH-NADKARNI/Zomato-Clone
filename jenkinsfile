pipeline {
    agent any

    tools {
        jdk 'JDK-21'
        nodejs 'NodeJS-24'
    }

    environment {
        SCANNER_HOME = tool 'sonar-scanner'
    }

    stages {

        stage('clean workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'master', url: 'https://github.com/dnadkarni369/ZomatoCl-CD.git'
            }
        }

        stage('Sonarqube Analysis') {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh '''
                    $SCANNER_HOME/bin/sonar-scanner \
                    -Dsonar.projectName=zomato \
                    -Dsonar.projectKey=zomato
                    '''
                }
            }
        }

        stage('quality gate') {
            steps {
                script {
                    waitForQualityGate abortPipeline: false, credentialsId: 'Ssonarcube-token'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }
        
        stage("Docker Build & Push"){
            steps{
                script{
                   withDockerRegistry(credentialsId: 'docker-id'){   
                       sh "docker build -t zomato ."
                       sh "docker tag zomato divya009/zomato:latest "
                       sh "docker push divya009/zomato:latest "
                    }
                }
            }
        }

        stage('TRIVY') {
            steps {
                sh 'trivy image divya009/zomato:latest > trivy.txt'
            }
        }

        stage('Deploy to container') {
            steps {
                sh 'docker run -d --name zomato -p 3000:3000 divya009/zomato:latest'
            }
        }
    }
}
